# ビルドコンテキストを小さく保つ。node_modules や仮想環境を送ると
# 転送に時間がかかるうえ、イメージ内で作り直すため意味がない。

.git
.gitignore

# Python
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache

# Node
frontend/node_modules
frontend/dist
frontend/smoke-output
*.tsbuildinfo

# 取り込み済みストア（コンテナ内で作り直す）
build
build_example

# その他
.DS_Store
.idea
.vscode
*.log
